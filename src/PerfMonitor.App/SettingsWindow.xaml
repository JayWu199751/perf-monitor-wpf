<Window x:Class="PerfMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="390"
        MinWidth="360"
        SizeToContent="Height"
        MaxHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6F8"
        Foreground="#FF242A31">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="设置"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <GroupBox Header="显示指标" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox x:Name="CpuCheckBox" Content="CPU" Tag="Cpu"
                              Checked="MetricChanged" Unchecked="MetricChanged" Margin="0,2" />
                    <CheckBox x:Name="MemoryCheckBox" Content="内存" Tag="Memory"
                              Checked="MetricChanged" Unchecked="MetricChanged" Margin="0,2" />
                    <CheckBox x:Name="GpuCheckBox" Tag="Gpu"
                              Checked="MetricChanged" Unchecked="MetricChanged" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU" />
                            <TextBlock Text="仅 NVIDIA" Opacity="0.65" Margin="8,0,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="NetworkCheckBox" Content="网络" Tag="Network"
                              Checked="MetricChanged" Unchecked="MetricChanged" Margin="0,2" />
                    <CheckBox x:Name="TimeCheckBox" Content="时间" Tag="Time"
                              Checked="MetricChanged" Unchecked="MetricChanged" Margin="0,2" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="刷新率" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU、内存、网络" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <ComboBox x:Name="FastRefreshComboBox" Grid.Column="1" Margin="0,0,0,8"
                              SelectedValuePath="Tag" SelectionChanged="FastRefreshChanged">
                        <ComboBoxItem Content="1 秒" Tag="1000" />
                        <ComboBoxItem Content="2 秒" Tag="2000" />
                        <ComboBoxItem Content="5 秒" Tag="5000" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="GPU、温度" VerticalAlignment="Center" />
                    <ComboBox x:Name="SlowRefreshComboBox" Grid.Row="1" Grid.Column="1"
                              SelectedValuePath="Tag" SelectionChanged="SlowRefreshChanged">
                        <ComboBoxItem Content="3 秒" Tag="3000" />
                        <ComboBoxItem Content="5 秒" Tag="5000" />
                    </ComboBox>
                </Grid>
            </GroupBox>

            <GroupBox Header="外观" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="主题" VerticalAlignment="Center" Margin="0,0,10,10" />
                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                              SelectedValuePath="Tag" SelectionChanged="ThemeChanged">
                        <ComboBoxItem Content="跟随系统" Tag="System" />
                        <ComboBoxItem Content="深色" Tag="Dark" />
                        <ComboBoxItem Content="亮色" Tag="Light" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="背景不透明度" VerticalAlignment="Center" Margin="0,0,10,10" />
                    <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1"
                            Minimum="0.20" Maximum="1.00" SmallChange="0.05" LargeChange="0.10"
                            ValueChanged="OpacityChanged" Margin="0,0,0,10" />
                    <TextBlock x:Name="OpacityValueText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right"
                               VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2" Text="字号" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider x:Name="FontSizeSlider" Grid.Row="2" Grid.Column="1"
                            Minimum="10" Maximum="18" SmallChange="1" LargeChange="2"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSizeChanged" />
                    <TextBlock x:Name="FontSizeValueText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </GroupBox>

            <DockPanel LastChildFill="True" Margin="0,2,0,0">
                <TextBlock x:Name="SaveStatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="#FF2A7D46" />
                <Button Content="关闭" Width="76" Height="30" HorizontalAlignment="Right"
                        Click="CloseButton_OnClick" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
