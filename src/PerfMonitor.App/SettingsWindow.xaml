<Window x:Class="PerfMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="性能小窗 · 设置"
        Width="380"
        MinWidth="380"
        MaxWidth="380"
        SizeToContent="Height"
        MinHeight="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- 压掉原生标题栏但保留标准窗口框架：DWM 阴影与 Win11 圆角随之保留；
         右上角关闭按钮与拖动区由内容区自绘（亮暗跟随主题画刷）。 -->
    <shell:WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF5F5F7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF707070" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0071E3" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFE8E8ED" />
        <SolidColorBrush x:Key="SwitchTrackBrush" Color="#3D787880" />
        <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
        <SolidColorBrush x:Key="HoverBrush" Color="#FFE0E0E6" />
        <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFFFF" />

        <Style x:Key="ControlFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,2,16,8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="SettingsSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="40" Height="24" CornerRadius="12"
                                Background="{DynamicResource SwitchTrackBrush}"
                                SnapsToDevicePixels="True">
                            <!-- 位移终点必须由 Setter 声明：开关在模板应用前就可能已为开，
                                 触发器动画在“生而激活”时不执行（Setter 不能指向变换对象，故用 Margin）；
                                 Enter/Exit 动画用显式 From/To 只负责过渡。 -->
                            <Ellipse x:Name="Thumb"
                                     Width="20" Height="20" Margin="2,2,2,2"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource ThumbBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Margin" Value="18,2,2,2" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                                Storyboard.TargetProperty="Margin"
                                                                From="2,2,2,2" To="18,2,2,2"
                                                                Duration="0:0:0.2" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                                Storyboard.TargetProperty="Margin"
                                                                From="18,2,2,2" To="2,2,2,2"
                                                                Duration="0:0:0.2" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,4,26,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" CornerRadius="15" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="15" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,4,26,4"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Path Width="10" Height="6" Margin="0,0,9,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0 0 L 5 5 L 10 0"
                                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Fade" StaysOpen="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0" Padding="4"
                                        Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="Opacity" Value="0.96" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboSurface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}"
                                                  Background="{DynamicResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}"
                                                  Background="{DynamicResource SwitchTrackBrush}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="18" Height="18"
                                           Focusable="False" IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource ThumbBrush}"
                                                         Stroke="{DynamicResource ControlBackgroundBrush}"
                                                         StrokeThickness="0.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Opacity" Value="0.48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.76" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘头部：标题行整行可拖动（关闭按钮自行吃掉鼠标事件不会误拖）；内容超高的滚动只发生在下方。 -->
        <Grid Background="Transparent" MinHeight="46" Margin="0,4,0,0"
              MouseLeftButtonDown="HeaderMouseLeftButtonDown">
            <TextBlock Text="设置" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Bottom" />
            <Button x:Name="CloseWindowButton"
                    Style="{StaticResource CaptionCloseButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    AutomationProperties.Name="关闭设置窗口"
                    Click="CloseWindowButton_OnClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,4,16,14">
                <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="显示指标" Style="{StaticResource GroupTitleStyle}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CPU 使用率" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="CpuToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Cpu" Checked="MetricChanged" Unchecked="MetricChanged"
                                      AutomationProperties.Name="CPU 使用率" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="内存" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="MemoryToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Memory" Checked="MetricChanged" Unchecked="MetricChanged"
                                      AutomationProperties.Name="内存" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GPU" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="仅 NVIDIA" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton x:Name="GpuToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Gpu" Checked="MetricChanged" Unchecked="MetricChanged"
                                      AutomationProperties.Name="GPU（仅 NVIDIA）" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="网络" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="NetworkToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Network" Checked="MetricChanged" Unchecked="MetricChanged"
                                      AutomationProperties.Name="网络" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="TimeToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Time" Checked="MetricChanged" Unchecked="MetricChanged"
                                      AutomationProperties.Name="时间" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="显示图标" Style="{StaticResource GroupTitleStyle}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CPU 图标" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="CpuIconToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Cpu" Checked="IconChanged" Unchecked="IconChanged"
                                      AutomationProperties.Name="CPU 图标" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="内存图标" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="MemoryIconToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Memory" Checked="IconChanged" Unchecked="IconChanged"
                                      AutomationProperties.Name="内存图标" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="GPU 图标" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="GpuIconToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Gpu" Checked="IconChanged" Unchecked="IconChanged"
                                      AutomationProperties.Name="GPU 图标" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="网络图标" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="NetworkIconToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Network" Checked="IconChanged" Unchecked="IconChanged"
                                      AutomationProperties.Name="网络图标" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="时间图标" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="TimeIconToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Time" Checked="IconChanged" Unchecked="IconChanged"
                                      AutomationProperties.Name="时间图标" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="刷新率" Style="{StaticResource GroupTitleStyle}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CPU、内存、网络" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="FastRefreshComboBox" Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  SelectedValuePath="Tag" SelectionChanged="FastRefreshChanged">
                            <ComboBoxItem Content="1 秒" Tag="1000" />
                            <ComboBoxItem Content="2 秒" Tag="2000" />
                            <ComboBoxItem Content="5 秒" Tag="5000" />
                        </ComboBox>
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <TextBlock Text="GPU、温度" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="SlowRefreshComboBox" Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  SelectedValuePath="Tag" SelectionChanged="SlowRefreshChanged">
                            <ComboBoxItem Content="3 秒" Tag="3000" />
                            <ComboBoxItem Content="5 秒" Tag="5000" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource GroupTitleStyle}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                        <TextBlock Text="主题" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  SelectedValuePath="Tag" SelectionChanged="ThemeChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                            <ComboBoxItem Content="亮色" Tag="Light" />
                        </ComboBox>
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <TextBlock Text="背景不透明度" Style="{StaticResource SettingLabelStyle}" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Minimum="0.20" Maximum="1.00" SmallChange="0.05" LargeChange="0.10"
                                ValueChanged="OpacityChanged" />
                        <TextBlock x:Name="OpacityValueText" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <TextBlock Text="字体大小" Style="{StaticResource SettingLabelStyle}" />
                        <Slider x:Name="FontSizeSlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Minimum="10" Maximum="18" SmallChange="1" LargeChange="2"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSizeChanged" />
                        <TextBlock x:Name="FontSizeValueText" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <TextBlock Text="行为" Style="{StaticResource GroupTitleStyle}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="开机自启" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="AutostartDisabledNote" Text="开发环境不可用" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        </StackPanel>
                        <ToggleButton x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="Autostart" Checked="BehaviorChanged" Unchecked="BehaviorChanged"
                                      AutomationProperties.Name="开机自启" />
                    </Grid>
                    <Border Height="0.5" Background="{DynamicResource DividerBrush}" />
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="其他应用全屏时自动隐藏" Style="{StaticResource SettingLabelStyle}" />
                        <ToggleButton x:Name="FullscreenAutoHideToggle" Grid.Column="1" Style="{StaticResource SettingsSwitchStyle}"
                                      Tag="AutoHideOnFullscreen" Checked="BehaviorChanged" Unchecked="BehaviorChanged"
                                      AutomationProperties.Name="其他应用全屏时自动隐藏" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SaveStatusText" Margin="0,2,0,0" HorizontalAlignment="Left"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
