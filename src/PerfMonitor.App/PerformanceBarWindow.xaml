<Window x:Class="PerfMonitor.App.PerformanceBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="性能小窗"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="{x:Null}"
        SizeToContent="Height"
        MinWidth="96"
        Width="96"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        Left="24"
        Top="24"
        PreviewMouseRightButtonUp="OnPreviewMouseRightButtonUp">
    <!--
      窗口 = 卡片 + 四周 16 DIP 透明边距（投影留白，PerformanceBarWindow.ShadowInsetDips）。
      窗口背景必须为 null：分层窗口中 alpha=0 像素系统级穿透，边距环不拦截鼠标；
      命中区=卡片本身（含透明显示模式，卡片背景保持 alpha=1）。
      摆放数学按"视觉矩形=窗口矩形内缩 16 DIP"补偿（IStartupShellHost.PerformanceBarVisualInsets）。
    -->
    <Window.Resources>
        <Geometry x:Key="CpuIcon">M8,7 L16,7 A1,1 0 0 1 17,8 L17,16 A1,1 0 0 1 16,17 L8,17 A1,1 0 0 1 7,16 L7,8 A1,1 0 0 1 8,7 Z M9,1 L9,5 M15,1 L15,5 M9,19 L9,23 M15,19 L15,23 M1,9 L5,9 M1,15 L5,15 M19,9 L23,9 M19,15 L23,15 M9.5,9.5 L14.5,9.5 L14.5,14.5 L9.5,14.5 Z</Geometry>
        <Geometry x:Key="MemoryIcon">M4,7 L20,7 A1,1 0 0 1 21,8 L21,16 A1,1 0 0 1 20,17 L4,17 A1,1 0 0 1 3,16 L3,8 A1,1 0 0 1 4,7 Z M6,10 L6,14 M9,10 L9,14 M12,10 L12,14 M15,10 L15,14 M18,10 L18,14 M6,17 L6,19 M10,17 L10,19 M14,17 L14,19 M18,17 L18,19</Geometry>
        <Geometry x:Key="GpuIcon">M4,6 L20,6 A1,1 0 0 1 21,7 L21,17 A1,1 0 0 1 20,18 L4,18 A1,1 0 0 1 3,17 L3,7 A1,1 0 0 1 4,6 Z M7,12 A3,3 0 1 1 13,12 A3,3 0 1 1 7,12 M14,12 A2,2 0 1 1 18,12 A2,2 0 1 1 14,12 M21,9 L23,9 M21,15 L23,15</Geometry>
        <Geometry x:Key="NetworkIcon">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M3,12 L21,12 M12,3 A15,15 0 0 1 12,21 M12,3 A15,15 0 0 0 12,21</Geometry>
        <Geometry x:Key="ClockIcon">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M12,7 L12,12 L15,14</Geometry>

        <Style x:Key="SegmentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding IconBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="{Binding IconSize}" />
            <Setter Property="Height" Value="{Binding IconSize}" />
            <Setter Property="Margin" Value="{Binding IconGap}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SegmentLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding LabelBrush}" />
            <Setter Property="FontSize" Value="{Binding LabelFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Card"
                Margin="16"
                Padding="{Binding CardPadding}"
                Background="{Binding BackgroundBrush}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="{Binding BorderThickness}"
                Effect="{Binding ShadowEffect}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        TextOptions.TextFormattingMode="Display">
                    <Border Style="{StaticResource SegmentBorderStyle}" Visibility="{Binding CpuVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SegmentIconStyle}" Data="{StaticResource CpuIcon}" />
                            <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="CPU" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding CpuPercentageText, Mode=OneWay}"
                                       Foreground="{Binding CpuPercentageBrush}"
                                       Margin="{Binding LabelGap}" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Foreground="{Binding CpuTemperatureBrush}"
                                       FontWeight="Normal"
                                       Margin="{Binding ReadingGap}">
                                <Run Text="{Binding CpuTemperatureValueText, Mode=OneWay}" />
                                <Run Text="{Binding CpuTemperatureUnitText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="{Binding DividerHeight}" Background="{Binding DividerBrush}"
                            Margin="{Binding DividerGap}" VerticalAlignment="Center" Visibility="{Binding CpuDividerVisibility}" />

                    <Border Style="{StaticResource SegmentBorderStyle}" Visibility="{Binding MemoryVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SegmentIconStyle}" Data="{StaticResource MemoryIcon}" />
                            <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="内存" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding MemoryPercentageText, Mode=OneWay}"
                                       Foreground="{Binding MemoryPercentageBrush}"
                                       Margin="{Binding LabelGap}" />
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="{Binding DividerHeight}" Background="{Binding DividerBrush}"
                            Margin="{Binding DividerGap}" VerticalAlignment="Center" Visibility="{Binding MemoryDividerVisibility}" />

                    <Border Style="{StaticResource SegmentBorderStyle}" Visibility="{Binding GpuVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SegmentIconStyle}" Data="{StaticResource GpuIcon}" />
                            <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="GPU" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding GpuPercentageText, Mode=OneWay}"
                                       Foreground="{Binding GpuPercentageBrush}"
                                       Margin="{Binding LabelGap}" />
                            <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="显存" Margin="{Binding ReadingGap}" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding GpuMemoryPercentageText, Mode=OneWay}"
                                       Foreground="{Binding GpuMemoryPercentageBrush}"
                                       Margin="{Binding LabelGap}" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Foreground="{Binding GpuTemperatureBrush}"
                                       FontWeight="Normal"
                                       Margin="{Binding ReadingGap}">
                                <Run Text="{Binding GpuTemperatureValueText, Mode=OneWay}" />
                                <Run Text="{Binding GpuTemperatureUnitText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="{Binding DividerHeight}" Background="{Binding DividerBrush}"
                            Margin="{Binding DividerGap}" VerticalAlignment="Center" Visibility="{Binding GpuDividerVisibility}" />

                    <Border Style="{StaticResource SegmentBorderStyle}" Visibility="{Binding NetworkVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SegmentIconStyle}" Data="{StaticResource NetworkIcon}" />
                            <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="网络" />
                            <TextBlock Text="↓"
                                       Foreground="{Binding NetworkDownloadArrowBrush}"
                                       FontSize="{Binding FontSize}" FontWeight="Medium"
                                       Margin="{Binding LabelGap}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding NetworkDownloadSpeedText, Mode=OneWay}"
                                       Foreground="{Binding NetworkDownloadBrush}" />
                            <TextBlock Text="MB/s"
                                       Foreground="{Binding NetworkDownloadUnitBrush}"
                                       FontSize="{Binding UnitFontSize}" FontWeight="Normal"
                                       Margin="1,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="↑"
                                       Foreground="{Binding NetworkUploadArrowBrush}"
                                       FontSize="{Binding FontSize}" FontWeight="Medium"
                                       Margin="{Binding ReadingGap}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding NetworkUploadSpeedText, Mode=OneWay}"
                                       Foreground="{Binding NetworkUploadBrush}" />
                            <TextBlock Text="MB/s"
                                       Foreground="{Binding NetworkUploadUnitBrush}"
                                       FontSize="{Binding UnitFontSize}" FontWeight="Normal"
                                       Margin="1,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="{Binding DividerHeight}" Background="{Binding DividerBrush}"
                            Margin="{Binding DividerGap}" VerticalAlignment="Center" Visibility="{Binding NetworkDividerVisibility}" />

                    <Border Style="{StaticResource SegmentBorderStyle}" Visibility="{Binding TimeVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SegmentIconStyle}" Data="{StaticResource ClockIcon}" />
                            <TextBlock Style="{StaticResource ReadingTextStyle}"
                                       Text="{Binding TimeText, Mode=OneWay}"
                                       Foreground="{Binding ForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
        </Border>
    </Grid>
</Window>
