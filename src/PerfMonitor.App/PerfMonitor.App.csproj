<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 版本与程序集信息（发布说明见 docs/release.md）。 -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>性能小窗</Product>
    <AssemblyTitle>性能小窗（PerfMonitor WPF 版）</AssemblyTitle>
    <Description>Windows 桌面性能悬浮条（CPU/内存/GPU/网络），WPF 重写版。</Description>
    <Company>PerfMonitor-WPF</Company>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- WPF 通过 app.manifest 声明进程 DPI；Windows Forms 仅用于 NotifyIcon。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PerfMonitor.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PerfMonitor.Core\PerfMonitor.Core.csproj" />
    <ProjectReference Include="..\..\src\PerfMonitor.Windows\PerfMonitor.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\tray-light-*.png;Resources\tray-dark-*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
